PORT=5000
MONGO_URI=mongodb://localhost:27017/airsense
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8001
OPENWEATHER_API_KEY=your-openweather-api-key
LLM_API_KEY=your-llm-api-key
LLM_PROVIDER=your-provider-name
DEMO_MODE=false
NODE_ENV=development

# ─── Citizen Alert Service (Telegram) ────────────────────────────────────────
# Get a bot token from @BotFather on Telegram: https://t.me/botfather
TELEGRAM_BOT_TOKEN=8635271893:AAFMk5JXVy-4p0nvKb2FTbs1Cyny-tjM_Zo
# Your personal Telegram chat_id or a group/channel id.
# DM @userinfobot on Telegram to find your chat_id.
TELEGRAM_ALERT_CHAT_ID=5279055766
# AQI threshold above which alerts fire (default: 300 = Severe on CPCB scale)
AQI_ALERT_THRESHOLD=300
# Cron schedule in server timezone (default: every 6 hours).
# Use "*/5 * * * *" for a demo — fires every 5 minutes.
ALERT_CRON_SCHEDULE=*/5 * * * *
# Set to "false" to disable the alert service without removing code.
ALERTS_ENABLED=true
