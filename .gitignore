# ─── ML Artifacts & Generated Files ────────────────────────────────────────────
# Generated chart/plot images (re-creatable, not source code)
ml-service/forecast_vs_actual.png
ml-service/**/*.png
ml-service/**/*.jpg

# NOTE: *.pkl files ARE tracked intentionally — they are pre-trained seasonal
# SARIMA models required for the app to serve forecasts without a slow re-training
# step at every startup. To regenerate: `python forecasting/train_seasonal_models.py`
# ml-service/models/*.pkl  ← intentionally NOT ignored

# Other large model formats (not used in this project)
ml-service/models/*.joblib
ml-service/models/*.h5
ml-service/models/*.pt
ml-service/models/*.onnx
ml-service/models/*.pb
ml-service/models/*.tflite

# Large data dumps (keep sample CSVs — they are source data)
ml-service/data/raw/
ml-service/data/processed/
ml-service/data/*.csv.bak
ml-service/data/prophet_cache/
cmdstan/

# Stan/Prophet compiled model cache
ml-service/data/prophet_cache/

