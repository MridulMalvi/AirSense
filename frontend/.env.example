# AirSense Frontend — Environment Variables
# Copy this file to .env and set values

# Base URL for the backend API. In development, Vite proxies /api → http://localhost:5000
# so you can leave this blank and just use the Vite proxy config.
# For production/staging, set the full URL, e.g. http://your-backend-url/api.
# Leave blank in local development so Vite proxies /api to http://localhost:5000.
VITE_API_BASE_URL=

# Firebase Cloud Messaging web push (used by the future alerts module)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
